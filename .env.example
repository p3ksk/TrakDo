# JWT signing key (REQUIRED — must be at least 32 chars hex)
SecretKey=replace-with-a-secure-random-key-at-least-32-chars

# MariaDB (used by docker-compose)
MARIADB_ROOT_PASSWORD=rootpassword
MARIADB_DATABASE=TrakDo
MARIADB_USER=trakdoUser
MARIADB_PASSWORD=trakdo1234

# Optional overrides
# TokenDurationMinutes=4320
