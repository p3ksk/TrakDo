# Required secret
SecretKey=replace-with-a-secure-random-key-at-least-32-chars

# MariaDB
MARIADB_ROOT_PASSWORD=rootpassword
MARIADB_DATABASE=MyApp
MARIADB_USER=myappUser
MARIADB_PASSWORD=myappPassword

# Optional port overrides
# API_PORT=8081
# SPA_PORT=4200
# MARIADB_PORT=3306
# TokenDurationMinutes=4320
